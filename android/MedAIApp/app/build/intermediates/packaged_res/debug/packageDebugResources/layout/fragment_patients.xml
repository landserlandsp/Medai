<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Список пациентов"
        android:textColor="@color/text_medai"
        android:textSize="24sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/patient1Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Иван Петров"
                android:textColor="@color/text_medai"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/patient1Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ЭКГ готов к проверке"
                android:textColor="@color/muted_medai" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/patient2Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Елена Смирнова"
                android:textColor="@color/text_medai"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/patient2Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Запланирован осмотр"
                android:textColor="@color/muted_medai" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
